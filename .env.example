# ============================================
#  LocalLeads — Configuração do Servidor
# ============================================

# Sua API key do Geoapify (NUNCA commite este arquivo real)
GEOAPIFY_API_KEY=cole_sua_chave_aqui

# Segredo para assinar os tokens HMAC (gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
TOKEN_SECRET=COLE_O_SECRET_GERADO_AQUI

# Porta do servidor
PORT=3000

# Ambiente: development | production
NODE_ENV=production

# Origens permitidas para CORS (separadas por vírgula)
# Deixe vazio para permitir qualquer origem (só em dev!)
# Ex: https://meudominio.com,https://www.meudominio.com
ALLOWED_ORIGINS=

# Exigir token HMAC nas chamadas /api/*  (true recomendado)
REQUIRE_TOKEN=true
